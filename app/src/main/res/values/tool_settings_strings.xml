    <string name="tool_settings_provider_title">搜索提供方</string>
    <string name="tool_settings_provider_keyless">Exa 免密搜索</string>
    <string name="tool_settings_provider_keyless_detail">无需账户或密钥，使用 Exa 提供的免密入口。免费额度和速率有限，可能暂时不可用；没有无限用量或可用性保证。</string>
    <string name="tool_settings_provider_key">Exa 自备 API 密钥</string>
    <string name="tool_settings_provider_key_detail">可选：使用你已持有的 Exa API 密钥。额度、费用及可用性取决于 Exa 与你的账户，不会自动购买或切换方案。</string>
    <string name="tool_settings_provider_docs">查看 Exa 官方 MCP 与密钥说明</string>
    <string name="tool_settings_sharing_title">外部分享与隐私</string>
    <string name="tool_settings_sharing_detail">搜索词会发送给所选提供方 Exa；网页读取会把所选网址发送给该网站。不会自动发送完整对话、附件或 GitHub/Copilot 凭据。返回内容不可信，不可当作指令。</string>
    <string name="tool_settings_sharing_consent">同意工具所需的外部分享</string>
    <string name="tool_settings_sharing_consent_detail">只有明确同意后才能使用搜索和网页读取。撤回同意会阻止后续请求，但不能收回已发送的搜索词。</string>
    <string name="tool_settings_sharing_blocked">尚未同意外部分享：即使开关已打开，搜索和网页读取仍不可用。</string>
